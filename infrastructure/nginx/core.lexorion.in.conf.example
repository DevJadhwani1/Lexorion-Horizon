# Install only after replacing the upstream and provisioning the TLS certificate.
upstream lexorion_core_frontend {
    server FRONTEND_PRIVATE_ADDRESS:9000;
}
server {
    listen 80;
    server_name core.lexorion.in;
    return 301 https://core.lexorion.in$request_uri;
}
server {
    listen 443 ssl;
    server_name core.lexorion.in;
    ssl_certificate /etc/letsencrypt/live/core.lexorion.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/core.lexorion.in/privkey.pem;
    location / {
        proxy_pass http://lexorion_core_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
